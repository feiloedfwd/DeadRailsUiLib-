function Tab:Slider(config)
    config = config or {}
    local range = config.Value or {}
    local min = range.Min or 0
    local max = range.Max or 100
    local step = config.Step or 1
    local value = math.clamp(range.Default or min, min, max)

    local decimals = 0
    do
        local text = tostring(step)
        local dot = text:find("%.")
        if dot then
            decimals = #text - dot
        end
    end
    local function format(v)
        return string.format("%." .. decimals .. "f", v)
    end

    local hasDesc = config.Desc ~= nil and config.Desc ~= ""
    local card = MakeCard(self, hasDesc and 58 or 46)
    local title, desc = BuildLabels(card, config, 50, false)
    if not hasDesc then
        title.Position = UDim2.new(0, 10, 0, 5)
        title.Size = UDim2.new(1, -68, 0, 16)
    end

    local valueLabel = Label(card, {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 5),
        Size = UDim2.fromOffset(52, 16),
        TextXAlignment = Enum.TextXAlignment.Right,
        Text = format(value),
    })

    local hit = New("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -5),
        Size = UDim2.new(1, -20, 0, 16),
        Parent = card,
    })
    local track = New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0, 6),
        BackgroundColor3 = Color3.new(0.04, 0.04, 0.04),
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        Parent = hit,
    }, {
        New("UICorner", { CornerRadius = UDim.new(1, 0) }),
        New("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Color = WHITE,
            Transparency = 0.7,
        }),
    })
    local fill = New("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Teal,
        BorderSizePixel = 0,
        Parent = track,
    }, {
        New("UICorner", { CornerRadius = UDim.new(1, 0) }),
        New("UIGradient", { Color = BUTTON_SEQ, Rotation = 90 }),
    })
    local thumb = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = track,
    }, {
        New("UICorner", { CornerRadius = UDim.new(1, 0) }),
        New("UIGradient", { Color = TEXT_SEQ, Rotation = 90 }),
        New("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Color = Theme.Teal,
            Transparency = 0,
            Thickness = 1,
        }),
    })

    local slider = { Value = value }
    AddCommon(slider, card, card, title, desc)

    local function render(animate)
        local alpha = (max == min) and 0 or math.clamp((slider.Value - min) / (max - min), 0, 1)
        if animate then
            Tween(fill, 0.05, { Size = UDim2.new(alpha, 0, 1, 0) })
            Tween(thumb, 0.05, { Position = UDim2.new(alpha, 0, 0.5, 0) })
        else
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            thumb.Position = UDim2.new(alpha, 0, 0.5, 0)
        end
        valueLabel.Text = format(slider.Value)
    end

    local function snap(raw)
        local v = min + math.floor((raw - min) / step + 0.5) * step
        v = tonumber(string.format("%.6f", v))
        return math.clamp(v, min, max)
    end

    function slider:Set(v, fire)
        v = snap(tonumber(v) or min)
        local changed = v ~= slider.Value
        slider.Value = v
        render(true)
        if changed and fire ~= false and config.Callback then
            task.spawn(config.Callback, v)
        end
    end
    function slider:Get()
        return slider.Value
    end

    local dragging = false
    local page = self.Scroller or self.Page
    local function updateFromX(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then
            return
        end
        local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        slider:Set(min + alpha * (max - min))
    end

    hit.InputBegan:Connect(function(input)
        if slider.Locked or not IsPress(input) then
            return
        end
        dragging = true
        page.ScrollingEnabled = false
        updateFromX(input.Position.X)
    end)
    self.Window:_connect(UIS.InputChanged, function(input)
        if dragging and IsMove(input) then
            updateFromX(input.Position.X)
        end
    end)
    self.Window:_connect(UIS.InputEnded, function(input)
        if dragging and IsPress(input) then
            dragging = false
            page.ScrollingEnabled = true
        end
    end)

    render(false)
    return slider
end

