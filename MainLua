function Tab:Button(config)
    config = config or {}
    local accent = Accents[config.Color or "Default"] or Accents.Default
    local card = MakeCard(self, 32, accent, "TextButton")
    MakeAutoHeight(card)
    local scale = New("UIScale", { Parent = card })

    local showArrow = config.Arrow ~= false
    local title, desc = BuildParagraph(card, config, showArrow and 30 or 12)
    title.TextColor3 = accent.Text
    if showArrow then
        Label(card, {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.fromOffset(14, 14),
            Text = ">",
            TextColor3 = accent.Text,
            TextXAlignment = Enum.TextXAlignment.Center,
        })
    end

    local button = {}
    AddCommon(button, card, card, title, desc)

    card.MouseButton1Down:Connect(function()
        if not button.Locked then
            Tween(scale, 0.08, { Scale = 0.98 })
        end
    end)
    local function release()
        Tween(scale, 0.12, { Scale = 1 })
    end
    card.MouseButton1Up:Connect(release)
    card.MouseLeave:Connect(release)
    card.MouseEnter:Connect(function()
        if not button.Locked then
            Tween(card, 0.12, { BackgroundTransparency = 0.1 })
        end
    end)
    card.MouseLeave:Connect(function()
        if not button.Locked then
            Tween(card, 0.12, { BackgroundTransparency = Theme.ButtonTransparency })
        end
    end)
    card.MouseButton1Click:Connect(function()
        if button.Locked then
            return
        end
        if config.Callback then
            task.spawn(config.Callback)
        end
    end)

    return button
end

-- Full card layout used when a Paragraph has a Thumbnail (banner) and/or Buttons:
--   [ banner image across the top ]
--   [ icon ]  Title
--             Description (rich text supported, e.g. colored dots)
--   [ button ]
--   [ button ]
local function BuildRichParagraph(card, config, accent)
    New("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = card,
    })
    New("UIPadding", {
        PaddingTop = UDim.new(0, 6),
        PaddingBottom = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 6),
        PaddingRight = UDim.new(0, 6),
        Parent = card,
    })

    -- Banner across the top
    local thumbSource = LoadImage(config.Thumbnail)
    if thumbSource then
        New("ImageLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, config.ThumbnailSize or 80),
            Image = thumbSource,
            ScaleType = Enum.ScaleType.Crop,
            LayoutOrder = 1,
            Parent = card,
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 6) }),
        })
    end

    -- Header row: icon on the left, text on the right
    local header = New("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 2,
        Parent = card,
    }, {
        New("UIListLayout", {
            Padding = UDim.new(0, 8),
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center,
        }),
    })

    local reserved = 0
    local imageSource = LoadImage(config.Image)
    if imageSource then
        local imageSize = config.ImageSize or 42
        New("ImageLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(imageSize, imageSize),
            Image = imageSource,
            ScaleType = Enum.ScaleType.Fit,
            LayoutOrder = 1,
            Parent = header,
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 8) }),
        })
        reserved = imageSize + 8
    end

    local textHolder = New("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -reserved, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 2,
        Parent = header,
    }, {
        New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
    })
    local title = Label(textHolder, {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Text = config.Title or "",
        TextSize = 14,
        TextWrapped = true,
        LayoutOrder = 1,
    })
    title.TextColor3 = accent.Text
    local desc
    if config.Desc ~= nil and config.Desc ~= "" then
        desc = Label(textHolder, {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Text = config.Desc,
            TextSize = 11,
            TextTransparency = 0.2,
            TextWrapped = true,
            RichText = true,
            TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2,
        })
    end

    -- Buttons inside the same card
    if config.Buttons and #config.Buttons > 0 then
        local holder = New("Frame", {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 3,
            Parent = card,
        }, {
            New("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
        })
        for index, info in ipairs(config.Buttons) do
            local bAccent = Accents[info.Color or "Default"] or Accents.Default
            local btn = New("TextButton", {
                AutoButtonColor = false,
                Text = "",
                BackgroundColor3 = bAccent.Bg,
                BackgroundTransparency = Theme.ButtonTransparency,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 28),
                LayoutOrder = index,
                Parent = holder,
            })
            StyleButton(btn, bAccent, 6)
            Label(btn, {
                Size = UDim2.new(1, -8, 1, 0),
                Position = UDim2.new(0, 4, 0, 0),
                Text = info.Title or "",
                TextColor3 = bAccent.Text,
                TextXAlignment = Enum.TextXAlignment.Center,
                TextTruncate = Enum.TextTruncate.AtEnd,
            })
            btn.MouseEnter:Connect(function()
                Tween(btn, 0.12, { BackgroundTransparency = 0.1 })
            end)
            btn.MouseLeave:Connect(function()
                Tween(btn, 0.12, { BackgroundTransparency = Theme.ButtonTransparency })
            end)
            btn.MouseButton1Click:Connect(function()
                if info.Callback then
                    task.spawn(info.Callback)
                end
            end)
        end
    end

    local paragraph = {}
    AddCommon(paragraph, card, card, title, desc)
    return paragraph
end

function Tab:Paragraph(config)
    config = config or {}
    local accent = Accents[config.Color or "Default"] or Accents.Default
    local card = MakeCard(self, 24, accent)
    MakeAutoHeight(card, 24)

    -- Thumbnail (banner) and/or Buttons switch the paragraph to the full card layout
    if config.Thumbnail or (config.Buttons and #config.Buttons > 0) then
        return BuildRichParagraph(card, config, accent)
    end

    -- Optional image on the left side of the paragraph
    local left = COMPACT.Left
    local imageSource = LoadImage(config.Image)
    if imageSource then
        local imageSize = config.ImageSize or 32
        New("ImageLabel", {
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, COMPACT.Left, 0.5, 0),
            Size = UDim2.fromOffset(imageSize, imageSize),
            Image = imageSource,
            ScaleType = Enum.ScaleType.Fit,
            Parent = card,
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 6) }),
        })
        left = COMPACT.Left + imageSize + 8
    end

    local title, desc = BuildParagraph(card, config, 10, {
        Left = left,
        Pad = COMPACT.Pad,
        TitleSize = COMPACT.TitleSize,
        DescSize = COMPACT.DescSize,
    })
    title.TextColor3 = accent.Text
    local paragraph = {}
    AddCommon(paragraph, card, card, title, desc)
    return paragraph
end

