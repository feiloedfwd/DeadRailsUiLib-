-- Space reserved on the top right of the topbar for the minimize button
local RIGHT_RESERVE = 34

function WolfUI:CreateWindow(config)
    config = config or {}
    local self = setmetatable({}, Window)
    self.Title = config.Title or "WolfUI"
    self.Author = config.Author or config.Credit
    self.Tabs = {}
    self.ActiveTab = nil
    self._conns = {}
    self._order = 0
    self.ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift

    if config.Theme then
        for k, v in pairs(config.Theme) do
            Theme[k] = v
        end
        Accents = BuildAccents()
    end

    local sidebarWidth = config.SidebarWidth or 118
    local topbarHeight = 40
    local bodyY = topbarHeight + 4

    self.Gui = CreateGui()

    self.Root = Panel(self.Gui, {
        Name = "Root",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = config.Size or UDim2.fromOffset(480, 320),
        ClipsDescendants = true,
    })
    self.Scale = New("UIScale", { Scale = config.Scale or 1, Parent = self.Root })
    self:_buildOpenPill()

    local topbar = New("Frame", {
        Name = "Topbar",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, topbarHeight),
        Active = true,
        Parent = self.Root,
    })
    self.TitleLabel = Label(topbar, {
        Text = self.Title,
        TextSize = Theme.TitleSize,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    self.AuthorLabel = Label(topbar, {
        Text = self.Author or "",
        TextSize = Theme.DescSize,
        TextTransparency = 0.35,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Visible = false,
    })
    Separator(self.Root, topbarHeight)

    -- Small minimize button on the top right (hides / shows the window)
    if config.MinimizeButton ~= false then
        local minimize = New("TextButton", {
            Name = "Minimize",
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.fromOffset(22, 22),
            BackgroundColor3 = Theme.Button,
            BackgroundTransparency = Theme.ButtonTransparency,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            ZIndex = 5,
            Parent = topbar,
        })
        local minimizeEdge = StyleButton(minimize, Accents.Default, 6)
        self.MinimizeLabel = Label(minimize, {
            Size = UDim2.new(1, 0, 1, 0),
            Text = "–",
            TextSize = 16,
            TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 6,
        })
        minimize.MouseEnter:Connect(function()
            Tween(minimize, 0.12, { BackgroundTransparency = 0.1 })
        end)
        minimize.MouseLeave:Connect(function()
            Tween(minimize, 0.12, { BackgroundTransparency = Theme.ButtonTransparency })
        end)
        minimize.MouseButton1Click:Connect(function()
            self:Toggle()
        end)
        self.MinimizeButton = minimize
    end

    local sidebar = New("Frame", {
        Name = "Sidebar",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, bodyY),
        Size = UDim2.new(0, sidebarWidth, 1, -bodyY),
        Parent = self.Root,
    })
    self.TabList = New("ScrollingFrame", {
        Name = "Tabs",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 2,
        ScrollBarImageTransparency = 0.5,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Parent = sidebar,
    }, {
        New("UIListLayout", {
            Padding = UDim.new(0, 5),
            SortOrder = Enum.SortOrder.LayoutOrder,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
        }),
        New("UIPadding", {
            PaddingLeft = UDim.new(0, 5),
            PaddingRight = UDim.new(0, 5),
            PaddingTop = UDim.new(0, 2),
            PaddingBottom = UDim.new(0, 6),
        }),
    })

    local divider = New("Frame", {
        Name = "Divider",
        BackgroundColor3 = Theme.Separator,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0, sidebarWidth, 0, bodyY + 4),
        Size = UDim2.new(0, 2, 1, -(bodyY + 12)),
        Parent = self.Root,
    })
    New("UIGradient", { Rotation = 90, Transparency = SHINE_SEQ, Parent = divider })
    self.Divider = divider

    self.Pages = New("Frame", {
        Name = "Pages",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Position = UDim2.new(0, sidebarWidth + 2, 0, bodyY),
        Size = UDim2.new(1, -(sidebarWidth + 2), 1, -bodyY),
        Parent = self.Root,
    })

    self:_layoutTopbar()

    local dragging, startInput, startPos = false, nil, nil
    topbar.InputBegan:Connect(function(input)
        if IsPress(input) then
            dragging = true
            startInput = input.Position
            startPos = self.Root.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if conn then
                        conn:Disconnect()
                    end
                end
            end)
        end
    end)

    self:_connect(UIS.InputChanged, function(input)
        if dragging and IsMove(input) then
            local delta = (input.Position - startInput) / self.Scale.Scale
            self.Root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    self:_connect(UIS.InputBegan, function(input, processed)
        if not processed and input.KeyCode == self.ToggleKey then
            self:Toggle()
        end
    end)

    return self
end

-- Small draggable pill shown while the window is minimized.
-- Click it to bring the window back. Drag it to move it out of the way.
function Window:_buildOpenPill()
    local pill = New("TextButton", {
        Name = "OpenPill",
        AutoButtonColor = false,
        Text = "",
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 12),
        Size = UDim2.fromOffset(150, 30),
        BackgroundColor3 = BLACK,
        BackgroundTransparency = Theme.PanelTransparency,
        BorderSizePixel = 0,
        Visible = false,
        Parent = self.Gui,
    })
    StyleButton(pill, Accents.Default, 15)
    self.PillLabel = Label(pill, {
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        Text = self.Title,
        TextSize = Theme.TextSize,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    self.OpenPill = pill

    pill.MouseEnter:Connect(function()
        Tween(pill, 0.12, { BackgroundTransparency = 0.1 })
    end)
    pill.MouseLeave:Connect(function()
        Tween(pill, 0.12, { BackgroundTransparency = Theme.PanelTransparency })
    end)

    local pressStart, startPos, moved = nil, nil, false
    pill.InputBegan:Connect(function(input)
        if IsPress(input) then
            pressStart = input.Position
            startPos = pill.Position
            moved = false
        end
    end)
    self:_connect(UIS.InputChanged, function(input)
        if pressStart and IsMove(input) then
            local delta = input.Position - pressStart
            if delta.Magnitude > 4 then
                moved = true
            end
            if moved then
                pill.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end)
    self:_connect(UIS.InputEnded, function(input)
        if pressStart and IsPress(input) then
            local wasDrag = moved
            pressStart = nil
            if not wasDrag then
                self:Show()
            end
        end
    end)
end

function Window:_layoutTopbar()
    local hasAuthor = self.Author ~= nil and self.Author ~= ""
    self.AuthorLabel.Visible = hasAuthor
    local rightSpace = self.MinimizeButton and RIGHT_RESERVE or 0
    if hasAuthor then
        self.TitleLabel.Position = UDim2.new(0, 12, 0, 5)
        self.TitleLabel.Size = UDim2.new(1, -(12 + rightSpace), 0, 17)
        self.AuthorLabel.Position = UDim2.new(0, 12, 0, 22)
        self.AuthorLabel.Size = UDim2.new(1, -(12 + rightSpace), 0, 13)
    else
        self.TitleLabel.Position = UDim2.new(0, 12, 0, 0)
        self.TitleLabel.Size = UDim2.new(1, -(12 + rightSpace), 1, 0)
    end
end

function Window:SetAuthor(text)
    self.Author = text
    self.AuthorLabel.Text = text or ""
    self:_layoutTopbar()
end

function Window:_connect(signal, fn)
    local conn = signal:Connect(fn)
    table.insert(self._conns, conn)
    return conn
end

function Window:_nextOrder()
    self._order = self._order + 1
    return self._order
end

function Window:SetTitle(text)
    self.Title = text
    self.TitleLabel.Text = text
    if self.PillLabel then
        self.PillLabel.Text = text
    end
end

function Window:SetToggleKey(keycode)
    self.ToggleKey = keycode
end

function Window:SetScale(scale)
    self.Scale.Scale = scale
end

function Window:SetTheme(themeTable)
    for k, v in pairs(themeTable) do
        Theme[k] = v
    end
    Accents = BuildAccents()

    self.Root.BackgroundTransparency = Theme.PanelTransparency
    self.TitleLabel.FontFace = Theme.Font
    self.TitleLabel.TextSize = Theme.TitleSize
    self.AuthorLabel.FontFace = Theme.Font
    self.AuthorLabel.TextSize = Theme.DescSize
    if self.Divider then
        self.Divider.BackgroundColor3 = Theme.Separator
    end

    for _, tab in ipairs(self.Tabs) do
        if tab == self.ActiveTab then
            tab.TabButton.BackgroundColor3 = Theme.Teal
        else
            tab.TabButton.BackgroundColor3 = Theme.Button
        end
        tab.TabButton.BackgroundTransparency = Theme.ButtonTransparency
        tab.ButtonLabel.FontFace = Theme.Font
        tab.ButtonLabel.TextSize = Theme.TextSize
    end
end

function Window:Show()
    self.Root.Visible = true
    self.OpenPill.Visible = false
end

function Window:Hide()
    self.Root.Visible = false
    self.OpenPill.Visible = true
end

function Window:Toggle()
    if self.Root.Visible then
        self:Hide()
    else
        self:Show()
    end
end

function Window:Destroy()
    for _, conn in ipairs(self._conns) do
        conn:Disconnect()
    end
    self._conns = {}
    self.Gui:Destroy()
end

function Window:Tab(config)
    config = config or {}
    local tab = setmetatable({}, Tab)
    tab.Window = self
    tab.Title = config.Title or ("Tab " .. tostring(#self.Tabs + 1))
    tab._order = 0

    tab.TabButton = New("TextButton", {
        Name = tab.Title,
        AutoButtonColor = false,
        Text = "",
        BackgroundColor3 = Theme.Button,
        BackgroundTransparency = Theme.ButtonTransparency,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 28),
        LayoutOrder = #self.Tabs + 1,
        Parent = self.TabList,
    })
    StyleButton(tab.TabButton, Accents.Default)
    tab.ButtonLabel = Label(tab.TabButton, {
        Size = UDim2.new(1, -8, 1, 0),
        Position = UDim2.new(0, 4, 0, 0),
        Text = tab.Title,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })

    tab.Page = New("ScrollingFrame", {
        Name = tab.Title,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageTransparency = 0.5,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Visible = false,
        Parent = self.Pages,
    }, {
        New("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
        }),
        New("UIPadding", {
            PaddingLeft = UDim.new(0, 6),
            PaddingRight = UDim.new(0, 8),
            PaddingTop = UDim.new(0, 2),
            PaddingBottom = UDim.new(0, 6),
        }),
    })

    tab.TabButton.MouseButton1Click:Connect(function()
        tab:Select()
    end)

    table.insert(self.Tabs, tab)
    if not self.ActiveTab then
        tab:Select()
    end
    return tab
end

function Tab:Select()
    local window = self.Window
    local previous = window.ActiveTab
    if previous and previous ~= self then
        previous.Page.Visible = false
        Tween(previous.TabButton, 0.15, { BackgroundColor3 = Theme.Button })
    end
    window.ActiveTab = self
    self.Page.Visible = true
    Tween(self.TabButton, 0.15, { BackgroundColor3 = Theme.Teal })
end

local function NextOrder(tab)
    tab._order = tab._order + 1
    return tab._order
end

local function BuildLabels(card, config, rightWidth, centered)
    local hasDesc = config.Desc ~= nil and config.Desc ~= ""
    local align = centered and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
    local reserved = centered and 20 or (rightWidth + 18)
    local title, desc

    if hasDesc then
        title = Label(card, {
            Position = UDim2.new(0, 10, 0, 5),
            Size = UDim2.new(1, -reserved, 0, 16),
            Text = config.Title or "",
            TextXAlignment = align,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
        desc = Label(card, {
            Position = UDim2.new(0, 10, 0, 22),
            Size = UDim2.new(1, -reserved, 0, 14),
            Text = config.Desc,
            TextSize = Theme.DescSize,
            TextTransparency = 0.35,
            TextXAlignment = align,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
    else
        title = Label(card, {
            Position = UDim2.new(0, 10, 0, 0),
            Size = UDim2.new(1, -reserved, 1, 0),
            Text = config.Title or "",
            TextXAlignment = align,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
    end
    return title, desc, hasDesc
end

local function MakeCard(tab, height, accent, className)
    accent = accent or Accents.Default
    local card = New(className or "Frame", {
        BackgroundColor3 = accent.Bg,
        BackgroundTransparency = Theme.ButtonTransparency,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = NextOrder(tab),
        Parent = tab.Page,
    })
    if className == "TextButton" then
        card.AutoButtonColor = false
        card.Text = ""
    end
    local edgeGradient = StyleButton(card, accent)
    return card, edgeGradient
end

local function AddCommon(object, outer, card, title, desc)
    object.Frame = outer
    object.Locked = false

    function object:SetTitle(text)
        title.Text = text
    end
    function object:SetDesc(text)
        if desc then
            desc.Text = text
        end
    end
    function object:Lock()
        object.Locked = true
        Tween(card, 0.15, { BackgroundTransparency = 0.6 })
        title.TextTransparency = 0.5
    end
    function object:Unlock()
        object.Locked = false
        Tween(card, 0.15, { BackgroundTransparency = Theme.ButtonTransparency })
        title.TextTransparency = 0
    end
    function object:Destroy()
        outer:Destroy()
    end
    if object.Locked == nil then
        object.Locked = false
    end
end

local function CardHeight(hasDesc, base)
    return hasDesc and 44 or (base or 32)
end

local function BuildParagraph(card, config, rightReserved, opts)
    opts = opts or {}
    local left = opts.Left or 12
    local pad = opts.Pad or 9
    local titleSize = opts.TitleSize or Theme.TextSize
    local descSize = opts.DescSize or Theme.DescSize
    local hasDesc = config.Desc ~= nil and config.Desc ~= ""
    local holder = New("Frame", {
        BackgroundTransparency = 1,
