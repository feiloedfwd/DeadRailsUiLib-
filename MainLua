        Visible = false,
    })
    local list = New("ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageTransparency = 0.5,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Parent = menu,
    }, {
        New("UIListLayout", {
            Padding = UDim.new(0, 3),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
        New("UIPadding", {
            PaddingLeft = UDim.new(0, 4),
            PaddingRight = UDim.new(0, 6),
            PaddingTop = UDim.new(0, 4),
            PaddingBottom = UDim.new(0, 4),
        }),
    })

    local dropdown = { Values = values, Opened = false }
    AddCommon(dropdown, container, card, title, desc)

    local current = nil
    local selectedSet = {}
    local options = {}

    local function selectedList()
        local out = {}
        for _, v in ipairs(values) do
            if selectedSet[v] then
                table.insert(out, v)
            end
        end
        return out
    end

    local function result()
        if multi then
            return selectedList()
        end
        return current
    end

    local function render()
        if multi then
            local picked = selectedList()
            selectedLabel.Text = (#picked > 0) and table.concat(picked, ", ") or "None"
        else
            selectedLabel.Text = current ~= nil and tostring(current) or "None"
        end
        for _, option in ipairs(options) do
            local on
            if multi then
                on = selectedSet[option.Value] == true
            else
                on = current == option.Value
            end
            Tween(option.Button, 0.12, { BackgroundColor3 = on and Theme.Teal or Theme.Button })
        end
    end

    local function fire()
        if config.Callback then
            task.spawn(config.Callback, result())
        end
    end

    local function setOpen(open)
        dropdown.Opened = open
        menu.Visible = open
        Tween(arrow, 0.15, { Rotation = open and 90 or 0 })
    end

    local function rebuild()
        for _, option in ipairs(options) do
            option.Button:Destroy()
        end
        options = {}
        for index, v in ipairs(values) do
            local button = New("TextButton", {
                AutoButtonColor = false,
                Text = "",
                BackgroundColor3 = Theme.Button,
                BackgroundTransparency = Theme.ButtonTransparency,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 23),
                LayoutOrder = index,
                Parent = list,
            })
            StyleButton(button, Accents.Default, 5)
            Label(button, {
                Size = UDim2.new(1, -8, 1, 0),
                Position = UDim2.new(0, 4, 0, 0),
                Text = tostring(v),
                TextXAlignment = Enum.TextXAlignment.Center,
                TextTruncate = Enum.TextTruncate.AtEnd,
            })
            local option = { Value = v, Button = button }
            table.insert(options, option)

            button.MouseButton1Click:Connect(function()
                if dropdown.Locked then
                    return
                end
                if multi then
                    if selectedSet[v] then
                        selectedSet[v] = nil
                    else
                        selectedSet[v] = true
                    end
                else
                    if current == v then
                        if allowNone then
                            current = nil
                        end
                    else
                        current = v
                    end
                    setOpen(false)
                end
                render()
                fire()
            end)
        end
        menu.Size = UDim2.new(1, 0, 0, math.clamp(#values * 26 + 8, 34, 140))
        render()
    end

    local function applyValue(value)
        current = nil
        selectedSet = {}
        if multi then
            if typeof(value) == "table" then
                for _, v in ipairs(value) do
                    selectedSet[v] = true
                end
            elseif value ~= nil then
                selectedSet[value] = true
            end
        else
            if typeof(value) == "number" then
                value = values[value]
            end
            current = value
        end
    end

    function dropdown:Set(value, shouldFire)
        applyValue(value)
        render()
        if shouldFire ~= false then
            fire()
        end
    end
    function dropdown:Get()
        return result()
    end
    function dropdown:Refresh(newValues)
        values = newValues or {}
        dropdown.Values = values
        local lookup = {}
        for _, v in ipairs(values) do
            lookup[v] = true
        end
        if current ~= nil and not lookup[current] then
            current = nil
        end
        for key in pairs(selectedSet) do
            if not lookup[key] then
                selectedSet[key] = nil
            end
        end
        rebuild()
    end
    function dropdown:Open()
        setOpen(true)
    end
    function dropdown:Close()
        setOpen(false)
    end

    hit.MouseButton1Click:Connect(function()
        if not dropdown.Locked then
            setOpen(not dropdown.Opened)
        end
    end)

    applyValue(config.Value)
    rebuild()
    return dropdown
end

return WolfUI
