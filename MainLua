local function BuildAccents()
    return {
        Default = { Bg = Theme.Button, Text = WHITE, Stroke = WHITE },
        Teal = { Bg = Theme.Teal, Text = WHITE, Stroke = WHITE },
        Green = { Bg = Theme.DarkGreen, Text = Theme.GreenText, Stroke = Theme.GreenStroke },
        Red = { Bg = Theme.DarkRed, Text = Theme.Red, Stroke = Theme.Red },
    }
end

local Accents = BuildAccents()

local function merge(base, extra)
    for k, v in pairs(extra or {}) do
        base[k] = v
    end
    return base
end

local function New(class, props, children)
    local inst = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then
            parent = v
        else
            inst[k] = v
        end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local function Tween(inst, time, props)
    local tw = TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function AddShine(inst)
    local stroke = New("UIStroke", {
        Name = "BorderStroke",
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = WHITE,
        Transparency = 0.625,
        Parent = inst,
    })
    New("UIGradient", { Rotation = 45, Transparency = SHINE_SEQ, Parent = stroke })
end

local function Panel(parent, props)
    local frame = New("Frame", merge({
        BackgroundColor3 = BLACK,
        BackgroundTransparency = Theme.PanelTransparency,
        BorderSizePixel = 0,
        Parent = parent,
    }, props))
    New("UICorner", { CornerRadius = UDim.new(0, 8), Parent = frame })
    AddShine(frame)
    return frame
end

local function StyleButton(inst, accent, radius)
    accent = accent or Accents.Default
    New("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = inst })
    New("UIGradient", { Color = BUTTON_SEQ, Rotation = 90, Parent = inst })
    local edge = New("UIStroke", {
        Name = "EdgeStroke",
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = WHITE,
        Transparency = 0.3,
        Parent = inst,
    })
    local edgeGradient = New("UIGradient", {
        Rotation = 78,
        Transparency = EDGE_SEQ,
        Color = ColorSequence.new(accent.Stroke),
        Parent = edge,
    })
    AddShine(inst)
    return edgeGradient
end

local function Label(parent, props)
    local label = New("TextLabel", merge({
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        FontFace = Theme.Font,
        TextColor3 = WHITE,
        TextSize = Theme.TextSize,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Text = "",
        Parent = parent,
    }, props))
    New("UIGradient", { Color = TEXT_SEQ, Rotation = 90, Parent = label })
    New("UIStroke", { Parent = label })
    return label
end

local function Separator(parent, y)
    local line = New("Frame", {
        BackgroundColor3 = Theme.Separator,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0, y),
        Size = UDim2.new(0.9, 0, 0, 2),
        Parent = parent,
    })
    New("UIGradient", { Transparency = SHINE_SEQ, Parent = line })
    return line
end

local function IsPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

-- Turns an image source into something an ImageLabel can show.
-- rbxassetid:// and rbxasset paths are used as-is.
-- http(s) URLs are downloaded once into the WolfUI folder (needs an executor with writefile/getcustomasset).
-- Returns nil when the image can't be loaded, so the paragraph just shows no image.
local function LoadImage(source)
    if typeof(source) ~= "string" or source == "" then
        return nil
    end
    if string.match(source, "^rbxassetid://") or string.match(source, "^rbxasset") then
        return source
    end
    if string.match(source, "^https?://") then
        if typeof(writefile) ~= "function" or typeof(getcustomasset) ~= "function" then
            return nil
        end
        local folder = "WolfUI"
        if typeof(isfolder) == "function" and not isfolder(folder) then
            makefolder(folder)
        end
        local name = string.gsub(source, "[^%w]", "_")
        local path = folder .. "/" .. string.sub(name, -80) .. ".png"
        if typeof(isfile) == "function" and not isfile(path) then
            local ok, data = pcall(function()
                return game:HttpGet(source)
            end)
            if not ok then
                return nil
            end
            writefile(path, data)
        end
        local ok, asset = pcall(getcustomasset, path)
        if ok then
            return asset
        end
    end
    return nil
end

local function CreateGui()
    local gui = Instance.new("ScreenGui")
    gui.Name = "WolfUI_" .. tostring(math.random(1000, 9999))
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 999
    gui.IgnoreGuiInset = true

    local parent
    if typeof(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok then
            parent = result
        end
    end
    if not parent then
        local ok, result = pcall(function()
            return svc("CoreGui")
        end)
        if ok then
            parent = result
        end
    end
    if typeof(syn) == "table" and syn.protect_gui then
        pcall(syn.protect_gui, gui)
    end

    local ok = pcall(function()
        gui.Parent = parent
    end)
    if not ok or not gui.Parent then
        gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    end
    return gui
end

